DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgres://user:password@localhost:5432/ai_cms

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Provider Keys (leave empty if not using)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=

# Local/Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_OPENAI_BASE_URL=http://localhost:8000
LOCAL_OPENAI_API_KEY=

# Tenant Configuration
DEFAULT_TENANT_SLUG=default

# Encryption (generate a proper key for production)
FIELD_ENCRYPTION_KEY=your-encryption-key-here

# Logging
LOG_LEVEL=INFO
